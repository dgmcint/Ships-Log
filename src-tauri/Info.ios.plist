<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Ship's Log uses the microphone to record audio log entries.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Ship's Log turns your speech into text when you dictate a log.</string>
  <!-- Lets backups in the app's Documents folder show in the Files app. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
