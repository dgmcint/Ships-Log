{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ship's Log",
  "version": "0.1.0",
  "identifier": "com.dgmcint.shipslog",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ship's Log",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Lifestyle",
    "shortDescription": "A starship-style personal journal",
    "longDescription": "Ship's Log is a personal journal with dictation, audio logs, photos and video, switchable skins and one-file backups.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
